{
  "name": "sidebar-tui-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "python3 -m unittest discover -s scripts -p 'test_*.py' && python3 scripts/test_runner.py",
    "test:unit": "python3 scripts/test_runner.py --suite unit",
    "test:tmux": "python3 scripts/test_runner.py --suite tmux",
    "test:e2e": "python3 scripts/test_runner.py --suite e2e --run-timeout 180",
    "test:full": "python3 scripts/test_runner.py --suite full --run-timeout 180",
    "test:desktop": "python3 scripts/test_runner.py --suite desktop --jobs 1 --timeout 60 --run-timeout 90",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.5.0"
  }
}
